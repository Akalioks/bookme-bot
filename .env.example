# 1) Get a token from @BotFather in Telegram and paste it here
BOT_TOKEN=

# 2) Your Telegram user id (get it from @userinfobot). Several: 111,222
#    These people receive new-booking notifications and see ALL bookings in /admin
ADMIN_IDS=

# true = anyone can open /admin but sees only their own bookings (for a public portfolio demo)
# false = /admin works only for ADMIN_IDS (for a real client)
DEMO_MODE=true

# Business info
BUSINESS_NAME=BookMe Barbershop
BUSINESS_ADDRESS=Viru 1, Tallinn
BUSINESS_PHONE=+372 5555 0000
TIMEZONE=Europe/Tallinn

# Schedule
OPEN_TIME=10:00
CLOSE_TIME=19:00
SLOT_STEP_MIN=30
DAYS_AHEAD=7
# 0=Mon ... 6=Sun, several: 5,6
CLOSED_WEEKDAYS=6
MIN_LEAD_MIN=30

# SQLite by default. PostgreSQL: postgresql+asyncpg://user:pass@host/db  (then: pip install asyncpg)
DATABASE_URL=sqlite+aiosqlite:///bookme.db
